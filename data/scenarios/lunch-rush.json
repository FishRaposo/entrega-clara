{
  "scenario_id": "lunch-rush",
  "description": "Almoço de demonstração: cliente pede marmitas, restaurante prepara, entregadora conclui.",
  "steps": [
    {
      "id": "add-marmitas",
      "actor": "demo-customer",
      "action": "cart.add_item",
      "params": {"menu_item_id": "menu-sm-01", "quantity": 2}
    },
    {
      "id": "add-guarana",
      "actor": "demo-customer",
      "action": "cart.add_item",
      "params": {"menu_item_id": "menu-sm-03", "quantity": 2}
    },
    {
      "id": "apply-coupon",
      "actor": "demo-customer",
      "action": "cart.apply_coupon",
      "params": {"code": "BEM-VINDO-DEMO"}
    },
    {
      "id": "checkout",
      "actor": "demo-customer",
      "action": "checkout",
      "params": {"address_id": "addr-casa", "payment_method": "pix"}
    },
    {
      "id": "confirm-order",
      "actor": "demo-rest-seu-manoel",
      "action": "restaurant.confirm",
      "params": {"order_id": "$order_id"}
    },
    {
      "id": "kitchen-wait",
      "action": "clock.advance",
      "params": {"minutes": 4}
    },
    {
      "id": "start-preparing",
      "actor": "demo-rest-seu-manoel",
      "action": "restaurant.prepare",
      "params": {"order_id": "$order_id"}
    },
    {
      "id": "preparation-wait",
      "action": "clock.advance",
      "params": {"minutes": 7}
    },
    {
      "id": "mark-ready",
      "actor": "demo-rest-seu-manoel",
      "action": "restaurant.ready",
      "params": {"order_id": "$order_id"}
    },
    {
      "id": "courier-accepts",
      "actor": "demo-courier",
      "action": "courier.accept",
      "params": {"delivery_id": "$delivery_id"}
    },
    {
      "id": "courier-arrives",
      "action": "clock.advance",
      "params": {"minutes": 2}
    },
    {
      "id": "pickup",
      "actor": "demo-courier",
      "action": "courier.pickup",
      "params": {"delivery_id": "$delivery_id"}
    },
    {
      "id": "start-route",
      "actor": "demo-courier",
      "action": "courier.start",
      "params": {"delivery_id": "$delivery_id"}
    },
    {
      "id": "location-midway",
      "actor": "demo-courier",
      "action": "courier.location",
      "params": {
        "delivery_id": "$delivery_id",
        "sequence": 1,
        "latitude": -23.5495,
        "longitude": -46.6355
      }
    },
    {
      "id": "location-near-customer",
      "actor": "demo-courier",
      "action": "courier.location",
      "params": {
        "delivery_id": "$delivery_id",
        "sequence": 2,
        "latitude": -23.5508,
        "longitude": -46.6335
      }
    },
    {
      "id": "final-leg",
      "action": "clock.advance",
      "params": {"minutes": 3}
    },
    {
      "id": "delivered",
      "actor": "demo-courier",
      "action": "courier.complete",
      "params": {"delivery_id": "$delivery_id"}
    }
  ]
}

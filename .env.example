APP_ENV=development
APP_NAME=Entrega Clara
DEFAULT_LOCALE=pt-BR
DEFAULT_CURRENCY=BRL
PERSISTENCE_MODE=memory
# DATABASE_URL is used only by the future PostgreSQL adapter; memory mode ignores it.
# DATABASE_URL=postgresql+psycopg://delivery:delivery@localhost:5432/delivery
DEMO_MODE=true
TRACKING_UPDATE_INTERVAL_SECONDS=2
# Optional: pin a specific street graph (absolute, or relative to the repo root).
# Default resolution: data/graph/sao-paulo-centro-osm.json, then the synthetic
# data/graph/sao-paulo-centro.json, then straight-line routing.
# ROUTING_GRAPH_PATH=
# Optional: pin a traffic profile (absolute, or relative to the repo root).
# Default: data/graph/traffic-profile.json. Missing or invalid means static ETAs.
# TRAFFIC_PROFILE_PATH=
# Optional: browser-visible MapTiler key upgrades the map from its fallback state.
# MAPTILER_API_KEY=
# MAPTILER_STYLE_URL=
